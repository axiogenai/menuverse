# ==============================================================================
# MenuVerse / Hotel Gypsy - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL via Prisma)
# ------------------------------------------------------------------------------
# Connect via transaction/session pooler or direct PostgreSQL URI.
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE STORAGE & CLIENT CREDENTIALS
# ------------------------------------------------------------------------------
# Public Supabase project URL and anon public key for frontend operations
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Service role secret key (Required for backend direct uploads to the menuverse bucket)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 3. AI ENGINE (Groq LPU - 100% Free on-demand LLM)
# ------------------------------------------------------------------------------
# Powers sub-second culinary dish descriptions and automated review replies
# Model: qwen/qwen3.8-27b
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# ------------------------------------------------------------------------------
# 4. OPTIONAL EXTERNAL INTEGRATIONS
# ------------------------------------------------------------------------------
# Google Places API Key (Optional fallback)
GOOGLE_PLACES_API_KEY=""

# Axiogen Cloud Review Syncer API Key (Oracle VM live reviews endpoint)
AXIOGEN_REVIEWS_API_KEY="axg_ccb1d2ebf263490f8f7dd44208b5e95b"
